{
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/v1/release_info", "destination": "/api/v1/release_info.json" }
  ]
}
